local toggleButtons = {}
 
local function createToggle(parent, text, initial, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 34)
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    btn.BorderSizePixel = 1
    btn.BorderColor3 = Color3.fromRGB(45, 45, 45)
    btn.Font = Enum.Font.Code
    btn.Text = (initial and "  [X] " or "  [ ] ") .. text
    btn.TextColor3 = initial and Color3.fromRGB(100, 160, 255) or Color3.fromRGB(180, 180, 180)
    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = parent
 
    local state = initial
    local function update(newState)
        state = newState
        btn.Text = (state and "  [X] " or "  [ ] ") .. text
        btn.TextColor3 = state and Color3.fromRGB(100, 160, 255) or Color3.fromRGB(180, 180, 180)
        callback(state)
    end
 
    btn.MouseButton1Click:Connect(function()
        update(not state)
    end)
 
    toggleButtons[text] = {Update = update, GetState = function() return state end}
    return btn
end
 
local function createDualToggleRow(parent, label1, init1, cb1, label2, init2, cb2)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 34)
    row.BackgroundTransparency = 1
    row.Parent = parent
 
    local function makeSubToggle(position, size, text, initial, callback)
        local btn = Instance.new("TextButton")
        btn.Size = size
        btn.Position = position
        btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        btn.BorderSizePixel = 1
        btn.BorderColor3 = Color3.fromRGB(45, 45, 45)
        btn.Font = Enum.Font.Code
        btn.Text = (initial and " [X] " or " [ ] ") .. text
        btn.TextColor3 = initial and Color3.fromRGB(100, 160, 255) or Color3.fromRGB(180, 180, 180)
        btn.TextSize = 12
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = row
 
        local state = initial
        local function update(newState)
            state = newState
            btn.Text = (state and " [X] " or " [ ] ") .. text
            btn.TextColor3 = state and Color3.fromRGB(100, 160, 255) or Color3.fromRGB(180, 180, 180)
            callback(state)
        end
 
        btn.MouseButton1Click:Connect(function()
            update(not state)
        end)
 
        toggleButtons[text] = {Update = update, GetState = function() return state end}
        return btn
    end
 
    makeSubToggle(UDim2.new(0, 0, 0, 0), UDim2.new(0.48, 0, 1, 0), label1, init1, cb1)
    makeSubToggle(UDim2.new(0.52, 0, 0, 0), UDim2.new(0.48, 0, 1, 0), label2, init2, cb2)
end
 
local function createSlider(parent, text, currentVal, minVal, maxVal, callback)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, 0, 0, 34)
    box.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    box.BorderColor3 = Color3.fromRGB(45, 45, 45)
    box.Font = Enum.Font.Code
    box.Text = "  " .. text .. ": " .. tostring(currentVal)
    box.TextColor3 = Color3.fromRGB(200, 200, 200)
    box.TextSize = 13
    box.TextXAlignment = Enum.TextXAlignment.Left
    box.Parent = parent
 
    box.FocusLost:Connect(function()
        local rawText = box.Text:match(": *([%d%.]+)") or box.Text
        local num = tonumber(rawText)
        if num then
            num = math.clamp(num, minVal, maxVal)
            box.Text = "  " .. text .. ": " .. tostring(num)
            callback(num)
        else
            box.Text = "  " .. text .. ": " .. tostring(currentVal)
        end
    end)
end
 
local function createKeybindButton(parent, featureName, currentKey)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 34)
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    btn.BorderSizePixel = 1
    btn.BorderColor3 = Color3.fromRGB(45, 45, 45)
    btn.Font = Enum.Font.Code
    btn.Text = "  " .. featureName .. " Key: [" .. tostring(currentKey.Name or currentKey) .. "]"
    btn.TextColor3 = Color3.fromRGB(180, 180, 180)
    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = parent
 
    local listening = false
    btn.MouseButton1Click:Connect(function()
        listening = true
        btn.Text = "  Press any key/mouse for " .. featureName .. "..."
        local connection
        connection = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Keyboard or input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
                local chosen = input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode or input.UserInputType
                Keybinds[featureName] = chosen
                btn.Text = "  " .. featureName .. " Key: [" .. tostring(chosen.Name or chosen) .. "]"
                listening = false
                connection:Disconnect()
            end
        end)
    end)
end
 
