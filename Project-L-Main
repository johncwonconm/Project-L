local function refreshPlayerList()
    for _, child in ipairs(playerListContainer:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
 
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local pBtn = Instance.new("TextButton")
            pBtn.Size = UDim2.new(1, 0, 0, 30)
            pBtn.BackgroundColor3 = (Config.SelectedTarget == p.Name) and Color3.fromRGB(40, 80, 140) or Color3.fromRGB(28, 28, 28)
            pBtn.BorderColor3 = Color3.fromRGB(45, 45, 45)
            pBtn.Font = Enum.Font.Code
            pBtn.Text = "  Target: " .. p.Name .. (Config.SelectedTarget == p.Name and " [SELECTED]" or "")
            pBtn.TextColor3 = (Config.SelectedTarget == p.Name) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)
            pBtn.TextSize = 12
            pBtn.TextXAlignment = Enum.TextXAlignment.Left
            pBtn.Parent = playerListContainer
 
            pBtn.MouseButton1Click:Connect(function()
                Config.SelectedTarget = p.Name
                refreshPlayerList()
            end)
        end
    end
end
 
